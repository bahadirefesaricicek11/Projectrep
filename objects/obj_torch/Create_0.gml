// Light properties from the PDF framework
radius = 160;          // How far the torch light reaches (max radius) [cite: 78]
c_light = c_orange;    // The color at the center of the torch [cite: 79]
intensity = 1.0;       // Brightness multiplier (0.0 to 1.0) [cite: 81]

// Time system parameters used in the PDF's render() function 
time_start = 0;        
time_end = 24;         
global.time = 12;      // Placeholder if you don't have a time system yet